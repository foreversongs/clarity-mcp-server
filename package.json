{
  "name": "@foreversongs/clarity-mcp-server-fork",
  "version": "3.1.0",
  "description": "MCP server for Microsoft Clarity, extended with dashboard /api/v2 access and custom-tag (variant) filtering",
  "license": "MIT",
  "type": "module",
  "main": "dist/src/index.js",
  "homepage": "https://github.com/foreversongs/clarity-mcp-server",
  "repository": {
    "type": "git",
    "url": "https://github.com/foreversongs/clarity-mcp-server.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "clarity",
    "behavior-analytics-tools",
    "session-recordings",
    "analytics",
    "mcp",
    "model-context-protocol",
    "ai",
    "agents"
  ],
  "bin": {
    "clarity-mcp-server": "./dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/index.js",
    "dev": "tsc && node dist/src/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "probe": "tsc && node dist/scripts/probe.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.19.23",
    "dotenv": "^17.4.2",
    "typescript": "^5.9.3",
    "vitest": "^2.1.8"
  }
}
